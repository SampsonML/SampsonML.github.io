---
layout: default
---
<canvas id="particle-network" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>
<script>
(function() {
  var canvas = document.getElementById('particle-network');
  var ctx = canvas.getContext('2d');
  var particles = [];
  var numParticles = Math.floor((window.innerWidth * window.innerHeight) / 12000);
  var connectDist = 150;
  var color = '142,192,124';

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  for (var i = 0; i < numParticles; i++) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.3,
      vy: (Math.random() - 0.5) * 0.3,
      r: Math.random() * 2 + 1
    });
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(' + color + ',0.6)';
      ctx.fill();

      for (var j = i + 1; j < particles.length; j++) {
        var p2 = particles[j];
        var dx = p.x - p2.x;
        var dy = p.y - p2.y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < connectDist) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.strokeStyle = 'rgba(' + color + ',' + (0.4 * (1 - dist / connectDist)) + ')';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>
<div class="post" style="position:relative;z-index:1;">
  <div class="hero-banner">
    <img src="{{ 'assets/img/dithered_brain.png' | relative_url }}" alt="Digital brain" />
    <div class="hero-overlay">
      <div class="hero-terminal">
        <div class="hero-terminal-bar">
          <span class="hero-terminal-dot" style="background:#cc241d;"></span>
          <span class="hero-terminal-dot" style="background:#d79921;"></span>
          <span class="hero-terminal-dot" style="background:#98971a;"></span>
          <span class="hero-terminal-title">~/about.sh</span>
        </div>
        <div class="hero-terminal-body">
          <p><span class="terminal-prompt">$</span> whoami</p>
          <h1 class="post-title">
            {% if site.title == 'blank' %}
              <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
              {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
          {% if page.typing_tagline %}
          <p class="hero-typing">
            <span class="terminal-prompt">$</span>&nbsp;<span id="typed-tagline"></span><span id="typing-cursor">|</span>
          </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% if page.typing_tagline %}
  <style>
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    #typing-cursor { animation: blink 0.7s step-end infinite; color: var(--global-theme-color); }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var text = {{ page.typing_tagline | jsonify }};
      var el = document.getElementById("typed-tagline");
      var i = 0;
      function type() {
        if (i < text.length) {
          el.textContent += text.charAt(i);
          i++;
          setTimeout(type, 45);
        }
      }
      type();
    });
  </script>
  {% endif %}

  <article>

    <!-- Bio terminal with profile grid -->
    <div class="section-terminal">
      <div class="section-terminal-bar">
        <span class="hero-terminal-dot" style="background:#cc241d;"></span>
        <span class="hero-terminal-dot" style="background:#d79921;"></span>
        <span class="hero-terminal-dot" style="background:#98971a;"></span>
        <span class="hero-terminal-title">~/bio.md</span>
      </div>
      <div class="section-terminal-body">
        <p class="bio-cmd"><span class="terminal-prompt">$</span> cat bio.md</p>
        <div class="bio-grid">
          <div class="bio-grid-text">{{ content }}</div>
          {% if page.profile %}
          <div class="bio-grid-profile">
            {% if page.profile.image %}
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
              {% endif %}
              {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
                cache_bust=true
              %}
            {% endif %}
            {% if page.profile.more_info %}
              <div class="more-info">{{ page.profile.more_info }}</div>
            {% endif %}
            {% if page.social %}
              <div class="social">
                <div class="contact-icons">{% include social.liquid %}</div>
              </div>
            {% endif %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <div class="section-terminal">
        <div class="section-terminal-bar">
          <span class="hero-terminal-dot" style="background:#cc241d;"></span>
          <span class="hero-terminal-dot" style="background:#d79921;"></span>
          <span class="hero-terminal-dot" style="background:#98971a;"></span>
          <span class="hero-terminal-title">~/news.log</span>
        </div>
        <div class="section-terminal-body">
          <p class="bio-cmd"><span class="terminal-prompt">$</span> tail -n 3 news.log</p>
          {% include news.liquid limit=true %}
        </div>
      </div>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <div class="section-terminal">
        <div class="section-terminal-bar">
          <span class="hero-terminal-dot" style="background:#cc241d;"></span>
          <span class="hero-terminal-dot" style="background:#d79921;"></span>
          <span class="hero-terminal-dot" style="background:#98971a;"></span>
          <span class="hero-terminal-title">~/posts/</span>
        </div>
        <div class="section-terminal-body">
          <p class="bio-cmd"><span class="terminal-prompt">$</span> ls -t posts/</p>
          {% include latest_posts.liquid %}
        </div>
      </div>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div class="section-terminal">
        <div class="section-terminal-bar">
          <span class="hero-terminal-dot" style="background:#cc241d;"></span>
          <span class="hero-terminal-dot" style="background:#d79921;"></span>
          <span class="hero-terminal-dot" style="background:#98971a;"></span>
          <span class="hero-terminal-title">~/papers.bib</span>
        </div>
        <div class="section-terminal-body">
          <p class="bio-cmd"><span class="terminal-prompt">$</span> grep --author="Wiemann" papers.bib | head -4</p>
          <p style="font-style: italic; color: var(--global-text-color-light); font-size: 0.9rem;">* previously published as Matt L. Sampson</p>
          {% include selected_papers.liquid %}
        </div>
      </div>
    {% endif %}

    <!-- Visitor map -->
    {% if site.clustrmaps and site.clustrmaps.enabled %}
      <div class="section-terminal">
        <div class="section-terminal-bar">
          <span class="hero-terminal-dot" style="background:#cc241d;"></span>
          <span class="hero-terminal-dot" style="background:#d79921;"></span>
          <span class="hero-terminal-dot" style="background:#98971a;"></span>
          <span class="hero-terminal-title">~/visitors.map</span>
        </div>
        <div class="section-terminal-body">
          <p class="bio-cmd"><span class="terminal-prompt">$</span> cat visitors.map</p>
          <div style="text-align: center;">
            {{ site.clustrmaps.embed }}
          </div>
        </div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
