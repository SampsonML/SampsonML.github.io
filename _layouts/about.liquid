---
layout: default
---
<div class="post">
  <div class="hero-banner">
    <img src="{{ 'assets/img/hero_bg.jpg' | relative_url }}" alt="" />
    <div class="hero-fade"></div>
    <div class="hero-overlay">
      <div class="hero-content">
        {% if page.hero_eyebrow %}
          <p class="hero-eyebrow">{{ page.hero_eyebrow }}</p>
        {% endif %}
        <div class="hero-identity">
          {% if page.profile and page.profile.image %}
            <img
              class="hero-portrait"
              src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}"
              alt="Portrait of {{ site.first_name }} {{ site.last_name }}"
            />
          {% endif %}
          <h1 class="hero-title">
            {% if site.title == 'blank' %}
              {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
        </div>
        {% if page.typing_tagline %}
          <p class="hero-subhead">
            <span id="typed-tagline"></span><span id="typing-cursor">|</span>
          </p>
        {% endif %}
        <div class="hero-actions">
          <a class="btn-pill btn-pill-primary" href="{{ '/cv/' | relative_url }}">CV</a>
          {% if page.social %}
            <div class="hero-social">{% include social.liquid %}</div>
          {% endif %}
        </div>
      </div>
      {% if page.research_strip %}
        <div class="research-strip">
          {% for item in page.research_strip %}
            <a class="research-card" href="{{ '/research-themes/' | relative_url }}">
              <span class="research-card-title">{{ item.title }}</span>
              <span class="research-card-blurb">{{ item.blurb }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  {% if page.typing_tagline %}
  <style>
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    #typing-cursor { animation: blink 0.7s step-end infinite; color: var(--global-theme-color); }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var text = {{ page.typing_tagline | jsonify }};
      var el = document.getElementById("typed-tagline");
      var i = 0;
      function type() {
        if (i < text.length) {
          el.textContent += text.charAt(i);
          i++;
          setTimeout(type, 45);
        }
      }
      type();
    });
  </script>
  {% endif %}

  <article>

    <!-- Bio terminal with profile grid -->
    <section class="home-section">
      <div class="section-body">
        <div class="bio-text">{{ content }}</div>
        {% if page.profile and page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <h2 class="section-heading">News</h2>
        <div class="section-body">
          {% include news.liquid limit=true %}
        </div>
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2 class="section-heading">Latest posts</h2>
        <div class="section-body">
          {% include latest_posts.liquid %}
        </div>
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section">
        <h2 class="section-heading">Selected publications</h2>
        <div class="section-body">
          <p style="font-style: italic; color: var(--global-text-color-light); font-size: 0.9rem;">* previously published as Matt L. Sampson</p>
          {% include selected_papers.liquid %}
        </div>
      </section>
    {% endif %}

    <!-- Visitor map -->
    {% if site.clustrmaps and site.clustrmaps.enabled %}
      <section class="home-section">
        <h2 class="section-heading">Visitors</h2>
        <div class="section-body">
          <div style="text-align: center;">
            {{ site.clustrmaps.embed }}
          </div>
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
